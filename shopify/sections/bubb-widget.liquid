<script>
  (function () {
    'use strict';

    function bbInitWidget(sectionId) {
      const root = document.querySelector('.bb-root-' + sectionId);
      if (!root) return;

      // Limpiar listeners previos de instancia anterior si Shopify recarga la sección
      if (root._bbAbortController) {
        root._bbAbortController.abort();
      }
      if (root._bbCuriousIntervalId) {
        clearInterval(root._bbCuriousIntervalId);
      }
      const abortController = new AbortController();
      root._bbAbortController = abortController;
      const signal = abortController.signal;

      const bubbleWrap = document.getElementById('bb-bubble-wrap-' + sectionId);
      const bubble = document.getElementById('bb-bubble-' + sectionId);
      const panelWrap = document.getElementById('bb-panel-wrap-' + sectionId);
      const panel = document.getElementById('bb-panel-' + sectionId);
      const form = root.querySelector('.bb-form');
      const successMsg = document.getElementById('bb-panel-success-' + sectionId);
      const panelCloseBtn = document.getElementById('bb-panel-close-' + sectionId);

      if (!bubble || !bubbleWrap || !panel || !panelWrap) return;

      const STORAGE_KEY = 'bb_bubble_pos_v1';
      const DRAG_THRESHOLD = 6;
      const SAFE_MARGIN = 12;

      let currentState = 'hidden';
      let riseTimeoutId = null;
      let autoCloseTimeoutId = null;
      let hoverResetTimeoutId = null;
      let hoverPassCount = 0;
      let isHovered = false;
      let formSubmitted = false;

      let dragX = 0;
      let dragY = 0;
      let isPointerDown = false;
      let isDragging = false;
      let wasDragged = false;
      let activePointerId = null;
      let startClientX = 0;
      let startClientY = 0;
      let startDragX = 0;
      let startDragY = 0;

      function getViewportBounds() {
        const vv = window.visualViewport;
        const vw = vv ? vv.width : window.innerWidth;
        const vh = vv ? vv.height : window.innerHeight;
        const offsetLeft = vv ? vv.offsetLeft : 0;
        const offsetTop = vv ? vv.offsetTop : 0;
        return { vw: vw, vh: vh, offsetLeft: offsetLeft, offsetTop: offsetTop };
      }

      function clampAndApplyPosition(targetX, targetY) {
        const rect = bubbleWrap.getBoundingClientRect();
        const baseLeft = rect.left - dragX;
        const baseTop = rect.top - dragY;
        const bw = rect.width || 84;
        const bh = rect.height || 84;

        const bounds = getViewportBounds();
        const minX = bounds.offsetLeft + SAFE_MARGIN - baseLeft;
        const maxX = bounds.offsetLeft + bounds.vw - SAFE_MARGIN - bw - baseLeft;
        const minY = bounds.offsetTop + SAFE_MARGIN - baseTop;
        const maxY = bounds.offsetTop + bounds.vh - SAFE_MARGIN - bh - baseTop;

        dragX = Math.min(Math.max(minX, maxX), Math.max(Math.min(minX, maxX), targetX));
        dragY = Math.min(Math.max(minY, maxY), Math.max(Math.min(minY, maxY), targetY));

        bubbleWrap.style.setProperty('--bb-drag-x', dragX.toFixed(1) + 'px');
        bubbleWrap.style.setProperty('--bb-drag-y', dragY.toFixed(1) + 'px');

        if (currentState === 'form-open') {
          positionPanelNearBubble();
        }
      }

      function savePosition() {
        try {
          window.localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({ x: Math.round(dragX), y: Math.round(dragY) })
          );
        } catch (err) {
          // Ignorar errores de storage
        }
      }

      function loadSavedPosition() {
        try {
          const raw = window.localStorage.getItem(STORAGE_KEY);
          if (!raw) return;
          const parsed = JSON.parse(raw);
          if (parsed && typeof parsed.x === 'number' && typeof parsed.y === 'number' && isFinite(parsed.x) && isFinite(parsed.y)) {
            clampAndApplyPosition(parsed.x, parsed.y);
          }
        } catch (err) {
          // Si falla la lectura o el JSON, mantener posición por defecto (0, 0)
        }
      }

      function positionPanelNearBubble() {
        const bRect = bubbleWrap.getBoundingClientRect();
        const pRect = panelWrap.getBoundingClientRect();
        const pBaseLeft = pRect.left - (parseFloat(panelWrap.style.getPropertyValue('--bb-panel-x')) || 0);
        const pBaseTop = pRect.top - (parseFloat(panelWrap.style.getPropertyValue('--bb-panel-y')) || 0);

        const bounds = getViewportBounds();
        const margin = 16;
        const pWidth = Math.min(356, bounds.vw - 28);
        const pHeight = panel.offsetHeight || 420;

        const bCenterX = bRect.left + bRect.width / 2;
        const bCenterY = bRect.top + bRect.height / 2;

        const spaceLeft = bCenterX - bounds.offsetLeft;
        const spaceRight = (bounds.offsetLeft + bounds.vw) - bCenterX;
        const spaceTop = bCenterY - bounds.offsetTop;
        const spaceBottom = (bounds.offsetTop + bounds.vh) - bCenterY;

        let desiredLeft;
        let originX;
        if (spaceLeft >= spaceRight) {
          desiredLeft = bRect.right - pWidth;
          originX = 'right';
        } else {
          desiredLeft = bRect.left;
          originX = 'left';
        }

        let desiredTop;
        let originY;
        if (spaceTop >= spaceBottom) {
          desiredTop = bRect.bottom - pHeight;
          originY = 'bottom';
        } else {
          desiredTop = bRect.top;
          originY = 'top';
        }

        const clampedLeft = Math.min(bounds.offsetLeft + bounds.vw - pWidth - margin, Math.max(bounds.offsetLeft + margin, desiredLeft));
        const clampedTop = Math.min(bounds.offsetTop + bounds.vh - pHeight - margin, Math.max(bounds.offsetTop + margin, desiredTop));

        const panelX = clampedLeft - pBaseLeft;
        const panelY = clampedTop - pBaseTop;

        panelWrap.style.setProperty('--bb-panel-x', panelX.toFixed(1) + 'px');
        panelWrap.style.setProperty('--bb-panel-y', panelY.toFixed(1) + 'px');
        panel.style.transformOrigin = originY + ' ' + originX;
      }

      function removeNodeSafely(node, fallbackMs) {
        let removed = false;
        const cleanup = function () {
          if (removed) return;
          removed = true;
          if (node && node.parentNode) {
            node.remove();
          }
        };
        node.addEventListener('animationend', cleanup, { once: true });
        setTimeout(cleanup, fallbackMs);
      }

      function triggerJellyPulse() {
        if (currentState !== 'floating') return;
        bubble.classList.remove('is-wobbling', 'is-curious', 'is-spinning');
        void bubble.offsetHeight;
        bubble.classList.add('is-wobbling');
      }

      function triggerCuriousGesture() {
        if (currentState !== 'floating') return;
        bubble.classList.remove('is-wobbling', 'is-curious', 'is-spinning');
        void bubble.offsetHeight;
        bubble.classList.add('is-curious');
      }

      function triggerSpinRotation() {
        if (currentState !== 'floating') return;
        bubble.classList.remove('is-wobbling', 'is-curious', 'is-spinning');
        void bubble.offsetHeight;
        bubble.classList.add('is-spinning');
      }

      function showBubble() {
        if (riseTimeoutId) {
          clearTimeout(riseTimeoutId);
          riseTimeoutId = null;
        }

        currentState = 'rising';
        panel.hidden = true;
        panel.classList.remove('is-open', 'is-closing');
        bubble.hidden = false;
        bubble.setAttribute('aria-expanded', 'false');
        bubble.classList.remove('is-floating', 'is-popping', 'is-reforming', 'is-dragging', 'is-wobbling', 'is-curious', 'is-spinning');
        void bubble.offsetHeight;
        bubble.classList.add('is-rising');
      }

      function reformBubble() {
        currentState = 'reforming';
        panel.hidden = true;
        panel.classList.remove('is-open', 'is-closing');
        bubble.hidden = false;
        bubble.setAttribute('aria-expanded', 'false');
        bubble.classList.remove('is-rising', 'is-floating', 'is-popping', 'is-dragging', 'is-wobbling', 'is-curious', 'is-spinning');

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
          const rect = bubbleWrap.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;

          const ring = document.createElement('div');
          ring.className = 'bb-ring is-imploding';
          ring.style.left = centerX + 'px';
          ring.style.top = centerY + 'px';
          root.appendChild(ring);
          removeNodeSafely(ring, 450);
        }

        void bubble.offsetHeight;
        bubble.classList.add('is-reforming');
      }

      function popBubble() {
        if (currentState !== 'floating') return;
        currentState = 'popping';

        bubble.setAttribute('aria-expanded', 'true');

        const rect = bubbleWrap.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        bubble.classList.remove('is-rising', 'is-floating', 'is-dragging', 'is-wobbling', 'is-curious', 'is-spinning');
        bubble.classList.add('is-popping');

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
          const ring = document.createElement('div');
          ring.className = 'bb-ring';
          ring.style.left = centerX + 'px';
          ring.style.top = centerY + 'px';
          root.appendChild(ring);
          removeNodeSafely(ring, 550);

          for (let i = 0; i < 12; i++) {
            const baseAngle = i * (360 / 12);
            const jitter = Math.random() * 16 - 8;
            const angleRad = ((baseAngle + jitter) * Math.PI) / 180;
            const distance = 50 + Math.random() * 60;
            const size = Math.floor(6 + Math.random() * 5);

            const dx = Math.cos(angleRad) * distance;
            const dy = Math.sin(angleRad) * distance;

            const droplet = document.createElement('div');
            droplet.className = 'bb-droplet';
            droplet.style.width = size + 'px';
            droplet.style.height = size + 'px';
            droplet.style.left = centerX + 'px';
            droplet.style.top = centerY + 'px';
            droplet.style.setProperty('--dx', dx.toFixed(1) + 'px');
            droplet.style.setProperty('--dy', dy.toFixed(1) + 'px');

            root.appendChild(droplet);
            removeNodeSafely(droplet, 700);
          }
        }
      }

      function openForm() {
        currentState = 'form-open';
        bubble.hidden = true;
        bubble.setAttribute('aria-expanded', 'true');

        if (form) form.hidden = false;
        if (successMsg) successMsg.hidden = true;

        panel.hidden = false;
        positionPanelNearBubble();
        panel.classList.remove('is-closing');
        void panel.offsetHeight;
        panel.classList.add('is-open');

        setTimeout(function () {
          if (currentState !== 'form-open') return;
          const firstAction = panel.querySelector('#bb-btn-join-' + sectionId);
          if (firstAction) firstAction.focus();
        }, 120);
      }

      function closeForm() {
        if (currentState !== 'form-open') return;
        currentState = 'closing';

        if (autoCloseTimeoutId) {
          clearTimeout(autoCloseTimeoutId);
          autoCloseTimeoutId = null;
        }

        panel.classList.remove('is-open');
        panel.classList.add('is-closing');
      }

      bubble.addEventListener('pointerdown', function (e) {
        if (currentState !== 'floating') return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;

        isPointerDown = true;
        isDragging = false;
        wasDragged = false;
        activePointerId = e.pointerId;
        startClientX = e.clientX;
        startClientY = e.clientY;
        startDragX = dragX;
        startDragY = dragY;

        try {
          bubble.setPointerCapture(e.pointerId);
        } catch (err) {
          // Ignorar si falla setPointerCapture
        }
      });

      bubble.addEventListener('pointermove', function (e) {
        if (isPointerDown && e.pointerId === activePointerId) {
          const dx = e.clientX - startClientX;
          const dy = e.clientY - startClientY;

          if (!isDragging && Math.hypot(dx, dy) >= DRAG_THRESHOLD) {
            isDragging = true;
            wasDragged = true;
            hoverPassCount = 0;
            bubble.classList.remove('is-wobbling', 'is-curious', 'is-spinning');
            bubble.classList.add('is-dragging');
          }

          if (isDragging) {
            e.preventDefault();
            clampAndApplyPosition(startDragX + dx, startDragY + dy);
          }
          return;
        }

        if (currentState !== 'floating') return;
        const rect = bubbleWrap.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = Math.max(-1, Math.min(1, (e.clientX - cx) / (rect.width / 2)));
        const dy = Math.max(-1, Math.min(1, (e.clientY - cy) / (rect.height / 2)));
        bubble.style.setProperty('--bb-mx', (dx * 8).toFixed(1) + 'px');
        bubble.style.setProperty('--bb-my', (dy * 8).toFixed(1) + 'px');
        bubble.style.setProperty('--bb-rot', (dx * 8).toFixed(1) + 'deg');
      });

      function endPointerDrag(e) {
        if (!isPointerDown || e.pointerId !== activePointerId) return;
        isPointerDown = false;
        activePointerId = null;

        try {
          if (bubble.hasPointerCapture(e.pointerId)) {
            bubble.releasePointerCapture(e.pointerId);
          }
        } catch (err) {
          // Ignorar si ya fue liberado
        }

        if (isDragging) {
          isDragging = false;
          bubble.classList.remove('is-dragging');
          clampAndApplyPosition(dragX, dragY);
          savePosition();
        }
      }

      bubble.addEventListener('pointerup', endPointerDrag);
      bubble.addEventListener('pointercancel', endPointerDrag);

      bubble.addEventListener('click', function (e) {
        if (wasDragged) {
          wasDragged = false;
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        if (currentState === 'floating') {
          popBubble();
        }
      });

      bubble.addEventListener('keydown', function (e) {
        if (currentState !== 'floating') return;

        const step = e.shiftKey ? 40 : 10;
        let moved = false;
        let nextX = dragX;
        let nextY = dragY;

        if (e.key === 'ArrowLeft') {
          nextX -= step;
          moved = true;
        } else if (e.key === 'ArrowRight') {
          nextX += step;
          moved = true;
        } else if (e.key === 'ArrowUp') {
          nextY -= step;
          moved = true;
        } else if (e.key === 'ArrowDown') {
          nextY += step;
          moved = true;
        }

        if (moved) {
          e.preventDefault();
          clampAndApplyPosition(nextX, nextY);
          savePosition();
        }
      });

      bubble.addEventListener('mouseenter', function () {
        isHovered = true;
        if (currentState !== 'floating' || isDragging) return;

        hoverPassCount += 1;
        if (hoverResetTimeoutId) clearTimeout(hoverResetTimeoutId);
        hoverResetTimeoutId = setTimeout(function () {
          hoverPassCount = 0;
        }, 6000);

        if (hoverPassCount > 2) {
          hoverPassCount = 0;
          triggerSpinRotation();
        }
      });

      bubble.addEventListener('mouseleave', function () {
        isHovered = false;
        bubble.style.setProperty('--bb-mx', '0px');
        bubble.style.setProperty('--bb-my', '0px');
        bubble.style.setProperty('--bb-rot', '0deg');
        if (currentState === 'floating' && !isDragging && !bubble.classList.contains('is-spinning')) {
          triggerJellyPulse();
        }
      });

      root._bbCuriousIntervalId = setInterval(function () {
        if (currentState === 'floating' && !isHovered && !isDragging && !document.hidden) {
          triggerCuriousGesture();
        }
      }, 9000);

      bubble.addEventListener('animationend', function (event) {
        if (event.animationName === 'bb-spike-jelly') {
          bubble.classList.remove('is-wobbling');
          return;
        }

        if (event.animationName === 'bb-spike-curious') {
          bubble.classList.remove('is-curious');
          return;
        }

        if (event.animationName === 'bb-spike-spin') {
          bubble.classList.remove('is-spinning');
          return;
        }

        if (event.target !== bubble) return;

        if (event.animationName === 'bb-rise' || event.animationName === 'bb-fade-in') {
          if (currentState === 'rising') {
            currentState = 'floating';
            bubble.classList.remove('is-rising');
            bubble.classList.add('is-floating');
          }
        }

        if (event.animationName === 'bb-pop' || event.animationName === 'bb-fade-out') {
          if (currentState === 'popping') {
            bubble.hidden = true;
            bubble.classList.remove('is-popping');
            openForm();
          }
        }

        if (event.animationName === 'bb-reform' || event.animationName === 'bb-fade-in') {
          if (currentState === 'reforming') {
            currentState = 'floating';
            bubble.classList.remove('is-reforming');
            bubble.classList.add('is-floating');
          }
        }
      });

      panel.addEventListener('animationend', function (event) {
        if (event.target !== panel) return;

        if (event.animationName === 'bb-panel-close' || event.animationName === 'bb-fade-out') {
          if (currentState === 'closing') {
            panel.hidden = true;
            panel.classList.remove('is-closing');
            if (form) form.hidden = false;
            if (successMsg) successMsg.hidden = true;

            if (formSubmitted) {
              formSubmitted = false;
              showBubble();
            } else {
              reformBubble();
            }

            bubble.focus();
          }
        }
      });

      if (panelCloseBtn) {
        panelCloseBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          closeForm();
        });
      }

      document.addEventListener('click', function (e) {
        if (currentState !== 'form-open') return;
        if (!panel.contains(e.target) && !bubble.contains(e.target)) {
          closeForm();
        }
      }, { signal: signal });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && currentState === 'form-open') {
          closeForm();
        }
      }, { signal: signal });

      function handleViewportChange() {
        clampAndApplyPosition(dragX, dragY);
      }

      window.addEventListener('resize', handleViewportChange, { signal: signal });
      window.addEventListener('orientationchange', function () {
        setTimeout(handleViewportChange, 60);
      }, { signal: signal });
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', handleViewportChange, { signal: signal });
      }

      if (form) {
        form.addEventListener('submit', function () {
          formSubmitted = true;
          autoCloseTimeoutId = setTimeout(function () {
            if (currentState === 'form-open') {
              closeForm();
            }
          }, 2000);
        });
      }

      loadSavedPosition();
      riseTimeoutId = setTimeout(showBubble, 800);
    }

    // Inicializar para el ID de sección actual
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        bbInitWidget('{{ section.id }}');
      });
    } else {
      bbInitWidget('{{ section.id }}');
    }

    // Soporte para recarga en tiempo real dentro del Editor de Temas de Shopify
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId) {
        bbInitWidget(e.detail.sectionId);
      }
    });
  })();
</script>

