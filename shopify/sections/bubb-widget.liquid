  }

  /* Gama de micro-interacciones de la silueta Spike */
  .bb-root-{{ section.id }} .bb-bubble.is-spike-mode.is-floating .bb-spike-actor {
    animation: bb-spike-silhouette-morph 5s ease-in-out infinite;
  }

  @keyframes bb-spike-silhouette-morph {
    0%, 100% { transform: skewX(0deg) skewY(0deg) scale(1, 1) rotate(0deg); }
    25% { transform: skewX(3.5deg) skewY(-2deg) scale(1.04, 0.96) rotate(-2.5deg); }
    50% { transform: skewX(-3deg) skewY(2.5deg) scale(0.96, 1.04) rotate(2deg); }
    75% { transform: skewX(2deg) skewY(1.5deg) scale(1.03, 0.97) rotate(-1.5deg); }
  }

  .bb-root-{{ section.id }} .bb-bubble.is-wobbling .bb-spike-actor {
    animation: bb-spike-jelly 680ms cubic-bezier(0.25, 1, 0.5, 1) forwards !important;
  }

  @keyframes bb-spike-jelly {
    0% { transform: scale(1, 1) skewX(0deg); }
    20% { transform: scale(1.2, 0.82) skewX(6deg) rotate(3deg); }
    40% { transform: scale(0.85, 1.16) skewX(-5deg) rotate(-3deg); }
    60% { transform: scale(1.09, 0.92) skewX(3deg) rotate(1.5deg); }
    80% { transform: scale(0.96, 1.04) skewX(-1.5deg) rotate(-0.8deg); }
    100% { transform: scale(1, 1) skewX(0deg) rotate(0deg); }
  }

  .bb-root-{{ section.id }} .bb-bubble.is-curious .bb-spike-actor {
    animation: bb-spike-curious 950ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards !important;
  }

  @keyframes bb-spike-curious {
    0% { transform: translateY(0) scale(1, 1) rotate(0deg); }
    25% { transform: translateY(-9px) scale(0.93, 1.1) rotate(-14deg) skewX(-4deg); }
    52% { transform: translateY(-6px) scale(1.08, 0.95) rotate(11deg) skewX(4deg); }
    76% { transform: translateY(-2px) scale(1.03, 0.98) rotate(-5deg); }
    100% { transform: translateY(0) scale(1, 1) rotate(0deg); }
  }

  .bb-root-{{ section.id }} .bb-bubble.is-spinning .bb-spike-actor {
    animation: bb-spike-spin 920ms cubic-bezier(0.22, 1, 0.36, 1) forwards !important;
  }

  @keyframes bb-spike-spin {
    0% { transform: scale(1, 1) rotate(0deg); }
    12% { transform: scale(0.92, 1.08) rotate(-22deg); }
    48% { transform: scale(1.12, 0.9) rotate(390deg); }
    82% { transform: scale(0.96, 1.04) rotate(740deg); }
    92% { transform: scale(1.03, 0.98) rotate(714deg); }
    100% { transform: scale(1, 1) rotate(720deg); }
  }

  .bb-root-{{ section.id }} .bb-bubble.is-popping {
    pointer-events: none !important;
    translate: 0 0 !important;
    scale: 1 1 !important;
    animation: bb-pop 280ms ease-out forwards !important;
  }

  @keyframes bb-pop {
    0% { transform: scale(1); opacity: 1; }
    43% { transform: scale(1.35); opacity: 1; }
    100% { transform: scale(1.8); opacity: 0; }
  }

