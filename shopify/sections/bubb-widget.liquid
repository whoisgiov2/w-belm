    z-index: 9999;
    transform: translate(-50%, -50%) scale(0.2);
    animation: bb-ring-burst 450ms cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
  }

  @keyframes bb-ring-burst {
    0% { transform: translate(-50%, -50%) scale(0.2); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1.8); opacity: 0; }
  }

  .bb-droplet {
    position: fixed;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.95) 0%, rgba(199, 210, 254, 0.65) 50%, rgba(168, 85, 247, 0.35) 100%);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 5px rgba(255, 255, 255, 0.6);
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%) translate(0, 0) scale(1);
    animation: bb-droplet-burst 600ms cubic-bezier(0.15, 0.85, 0.35, 1) forwards;
  }

  @keyframes bb-droplet-burst {
    0% { transform: translate(-50%, -50%) translate(0, 0) scale(1); opacity: 1; }
    65% { opacity: 0.9; }
    100% { transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(0); opacity: 0; }
  }

  /* Regeneración inversa a la explosión (al cerrar sin enviar) */
  .bb-root-{{ section.id }} .bb-bubble.is-reforming {
    pointer-events: none !important;
    translate: 0 0 !important;
    scale: 1 1 !important;
    animation: bb-reform 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  @keyframes bb-reform {
    0% { transform: scale(1.6); opacity: 0; }
    35% { transform: scale(1.22); opacity: 0.85; }
    65% { transform: scale(0.94); opacity: 1; }
    82% { transform: scale(1.04); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  .bb-root-{{ section.id }} .bb-bubble.is-reforming .bb-logo {
    animation: bb-logo-reform 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  @keyframes bb-logo-reform {
    0% { transform: scale(0.5); opacity: 0; filter: brightness(2.2); }
    60% { transform: scale(1.15); opacity: 0.9; filter: brightness(1.5); }
    100% { transform: scale(1); opacity: 1; filter: brightness(1); }
  }

  .bb-ring.is-imploding {
    animation: bb-ring-implode 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  @keyframes bb-ring-implode {
    0% { transform: translate(-50%, -50%) scale(1.8); opacity: 0.8; }
    100% { transform: translate(-50%, -50%) scale(0.4); opacity: 0; }
  }

  /* ==========================================================================
     PANEL DEL FORMULARIO DE CONTACTO (CONTENEDOR DE POSICIÓN + PANEL INTERNO)
     ========================================================================== */
  .bb-root-{{ section.id }} .bb-panel-wrap {
