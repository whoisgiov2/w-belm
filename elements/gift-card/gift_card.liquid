{% layout none %}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" lang="{{ request.locale.iso_code | default: 'es' }}">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark only">
  <meta name="supported-color-schemes" content="dark only">
  <title>Te damos la bienvenida al caos | {{ shop.name | default: 'w-belm' }}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Carter+One&family=Luckiest+Guy&display=swap" rel="stylesheet">

  {%- comment -%}
    ==========================================================================
    w-belm — Gift Card "Chaos Ticket" (diseño editorial tipo póster / zine)
    - Correo: Gmail, Apple Mail, Outlook (VML), Yahoo, clientes móviles
    - Tienda: templates/gift_card.liquid
    Sin esquinas redondeadas, sin pastillas ni cajas punteadas: bloques sólidos,
    número gigante con sombra dura, título tipo "nota de rescate", código en
    fichas individuales y código de barras decorativo.
    ==========================================================================
  {%- endcomment -%}

  {%- assign discount_code = 'WELCOME10' -%}
  {%- if gift_card and gift_card.code -%}
    {%- assign discount_code = gift_card.code -%}
  {%- endif -%}
  {%- assign code_chars = discount_code | split: '' -%}

  {%- assign store_url = shop.url | default: '/' -%}
  {%- assign discount_url = store_url | append: '/discount/' | append: discount_code | append: '?redirect=/' -%}

  {%- assign bg_asset = 'fondoini.jpg' | asset_img_url: '1200x' -%}
  {%- assign logo_asset = 'spike.png' | asset_img_url: '120x' -%}

  {%- assign barcode = '3,1,1,2,4,1,2,1,1,3,2,1,1,1,4,2,1,2,3,1,1,2,2,1,3,1,1,4,1,2' | split: ',' -%}

  <style type="text/css">
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #000000; }

    .ct-title { font-family: 'Luckiest Guy', Impact, 'Arial Black', sans-serif !important; }
    .ct-display { font-family: 'Carter One', 'Trebuchet MS', 'Arial Black', sans-serif !important; }

    .ct-cta-main:hover { background-color: #900808 !important; }
    .ct-cta-arrow:hover { background-color: #ffffff !important; color: #780606 !important; }
    .ct-tile { cursor: pointer; }

    @media only screen and (max-width: 620px) {
      .ct-wrap { width: 100% !important; }
      .ct-col { display: block !important; width: 100% !important; box-sizing: border-box; }
      .ct-pad { padding-left: 20px !important; padding-right: 20px !important; }
      .ct-giant { font-size: 104px !important; line-height: 96px !important; }
      .ct-ransom { font-size: 24px !important; line-height: 44px !important; }
      .ct-tile { width: 28px !important; height: 38px !important; font-size: 20px !important; }
      .ct-cta-main { font-size: 17px !important; padding-left: 16px !important; }
      .ct-hide-sm { display: none !important; }
    }

    @media print {
      .ct-cta-row { display: none !important; }
    }
  </style>

  <!--[if mso]>
  <style type="text/css">
    .ct-title { font-family: Impact, 'Arial Black', sans-serif !important; }
    .ct-display, body, td, p, a, span { font-family: 'Trebuchet MS', Arial, sans-serif !important; }
  </style>
  <![endif]-->
</head>

<body style="margin:0; padding:0; background-color:#000000;">

  <!-- Preheader oculto (vista previa en la bandeja de entrada) -->
  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#000000;">
    10% de descuento en tu primera compra con el código {{ discount_code }}. Bienvenido al caos.
  </div>

  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color:#000000;">
    <tr>
      <td align="center" style="padding:28px 10px;">

        <!--[if gte mso 9]>
        <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px;">
        <v:fill type="frame" src="{{ bg_asset }}" color="#0d0101" />
        <v:textbox inset="0,0,0,0">
        <![endif]-->

        <!-- ===================== TICKET ===================== -->
        <table class="ct-wrap" width="600" cellpadding="0" cellspacing="0" border="0" role="presentation"
               style="width:600px; max-width:600px; background-color:#0d0101; background-image:url('{{ bg_asset }}'); background-size:cover; background-position:center; background-repeat:no-repeat;">

          <!-- 1. Franja superior: cinta de marca -->
          <tr>
            <td style="background-color:#780606; padding:0;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td width="44" valign="middle" style="padding:10px 0 10px 18px;">
                    <img src="{{ logo_asset }}" onerror="this.onerror=null;this.src='spike.png';" width="26" height="26" alt="{{ shop.name | default: 'Spike' }}" style="width:26px; height:26px;">
                  </td>
                  <td valign="middle" class="ct-title" style="padding:10px 8px; font-family:'Luckiest Guy', Impact, sans-serif; font-size:15px; letter-spacing:3px; color:#ffffff; text-transform:uppercase;">
                    Welcome to the chaos
                  </td>
                  <td align="right" valign="middle" class="ct-display ct-hide-sm" style="padding:10px 18px 10px 8px; font-family:'Carter One', 'Trebuchet MS', sans-serif; font-size:12px; letter-spacing:2px; color:#000000; text-transform:uppercase;">
                    Ticket Nº 001
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Contenido sobre fondoini.jpg con velo oscuro -->
          <tr>
            <td style="background-color:rgba(8,0,0,0.80); padding:0;">

              <!-- 2. Héroe: número gigante + oferta -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td class="ct-col ct-pad" width="330" valign="bottom" style="padding:40px 0 10px 34px;">
                    <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td class="ct-display" style="border-left:5px solid #780606; padding:2px 0 2px 10px; font-family:'Carter One', 'Trebuchet MS', sans-serif; font-size:13px; letter-spacing:3px; color:#ffffff; text-transform:uppercase;">
                          Oferta especial
                        </td>
                      </tr>
                    </table>
                    <div class="ct-title ct-giant" style="font-family:'Luckiest Guy', Impact, sans-serif; font-size:138px; line-height:128px; color:#ffffff; letter-spacing:-2px; text-shadow:7px 7px 0 #780606; margin-top:14px;">
                      10%
                    </div>
                  </td>
                  <td class="ct-col ct-pad" valign="bottom" style="padding:40px 34px 18px 10px;">
                    <div class="ct-title" style="font-family:'Luckiest Guy', Impact, sans-serif; font-size:34px; line-height:34px; color:#ffffff; text-transform:uppercase;">
                      de<br>descuento
                    </div>
                    <div class="ct-display" style="font-family:'Carter One', 'Trebuchet MS', sans-serif; font-size:15px; color:#ff4d4d; margin-top:8px; letter-spacing:1px;">
                      en Página de inicio
                    </div>
                    <div style="width:56px; height:6px; background-color:#780606; margin-top:14px; font-size:1px; line-height:1px;">&nbsp;</div>
                  </td>
                </tr>
              </table>

              <!-- 3. Título estilo nota de rescate -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td class="ct-pad ct-title ct-ransom" style="padding:26px 34px 6px 34px; font-family:'Luckiest Guy', Impact, sans-serif; font-size:28px; line-height:50px; text-transform:uppercase;">
                    <span style="background-color:#ffffff; color:#000000; padding:4px 10px;">Te</span>
                    <span style="background-color:#000000; color:#ffffff; padding:4px 10px; border:2px solid #ffffff;">damos</span>
                    <span style="background-color:#780606; color:#ffffff; padding:4px 10px;">la</span>
                    <span style="background-color:#ffffff; color:#780606; padding:4px 10px;">bienvenida</span>
                    <span style="background-color:#000000; color:#ffffff; padding:4px 10px; border:2px solid #780606;">al</span>
                    <span style="background-color:#780606; color:#000000; padding:4px 12px;">caos.</span>
                  </td>
                </tr>
                <tr>
                  <td class="ct-pad" style="padding:14px 34px 0 34px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; font-size:15px; line-height:24px; color:#e5e5e5;">
                    ¡Qué bueno tenerte aquí! Disfruta este descuento en tu primera compra.
                  </td>
                </tr>
              </table>

              <!-- 4. Código en fichas individuales -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td class="ct-pad ct-display" style="padding:30px 34px 10px 34px; font-family:'Carter One', 'Trebuchet MS', sans-serif; font-size:12px; letter-spacing:3px; color:#ff4d4d; text-transform:uppercase;">
                    Usa el código
                  </td>
                </tr>
                <tr>
                  <td class="ct-pad" style="padding:0 34px;">
                    <table cellpadding="0" cellspacing="0" border="0" role="presentation" id="ctTiles" onclick="ctCopyCode()" title="Copiar código">
                      <tr>
                        {%- for ch in code_chars -%}
                          {%- assign odd = forloop.index | modulo: 2 -%}
                          <td style="padding:0 4px 0 0;">
                            <div class="ct-tile ct-title" style="width:38px; height:50px; line-height:52px; text-align:center; font-family:'Luckiest Guy', Impact, sans-serif; font-size:26px; {% if odd == 1 %}background-color:#ffffff; color:#000000;{% else %}background-color:#780606; color:#ffffff;{% endif %}">{{ ch }}</div>
                          </td>
                        {%- endfor -%}
                      </tr>
                    </table>
                    <span id="ctCode" style="display:none;">{{ discount_code }}</span>
                  </td>
                </tr>
                <tr>
                  <td class="ct-pad" style="padding:14px 34px 0 34px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; font-size:13.5px; line-height:22px; color:#a3a3a3;">
                    Usa el código: <strong style="color:#ffffff;">{{ discount_code }}</strong> al pagar, o haz clic en el enlace de abajo para aplicar el descuento automáticamente a tu pedido.
                    <span id="ctCopyMsg" style="color:#ff4d4d; font-weight:700;"></span>
                  </td>
                </tr>
              </table>

              <!-- 5. CTA en barra completa -->
              <table class="ct-cta-row" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td style="padding:30px 0 0 0;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td style="background-color:#780606;">
                          <a href="{{ discount_url }}" target="_blank" class="ct-title ct-cta-main"
                             style="display:block; background-color:#780606; color:#ffffff; text-decoration:none; font-family:'Luckiest Guy', Impact, sans-serif; font-size:21px; letter-spacing:3px; text-transform:uppercase; padding:22px 0 20px 34px;">
                            Aplicar descuento
                          </a>
                        </td>
                        <td width="76" style="background-color:#000000;">
                          <a href="{{ discount_url }}" target="_blank" class="ct-cta-arrow"
                             style="display:block; background-color:#000000; color:#ffffff; text-decoration:none; text-align:center; font-family:Arial, sans-serif; font-size:30px; font-weight:700; padding:16px 0 18px 0;">
                            &rarr;
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- 6. Pie: código de barras decorativo + datos de tienda -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td class="ct-col ct-pad" valign="middle" style="padding:24px 0 26px 34px;">
                    <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        {%- for w in barcode -%}
                          {%- assign px = w | times: 2 -%}
                          {%- assign even = forloop.index | modulo: 2 -%}
                          <td width="{{ px }}" height="34" style="width:{{ px }}px; height:34px; font-size:1px; line-height:1px; background-color:{% if even == 1 %}#ffffff{% else %}transparent{% endif %};">&nbsp;</td>
                        {%- endfor -%}
                      </tr>
                    </table>
                    <div class="ct-display" style="font-family:'Carter One', 'Trebuchet MS', sans-serif; font-size:10px; letter-spacing:5px; color:#737373; margin-top:4px;">{{ discount_code }}</div>
                  </td>
                  <td class="ct-col ct-pad" align="right" valign="middle" style="padding:24px 34px 26px 10px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; font-size:12px; line-height:19px; color:#737373; text-align:right;">
                    <span class="ct-display" style="font-family:'Carter One', 'Trebuchet MS', sans-serif; color:#ffffff; font-size:14px;">{{ shop.name | default: 'w-belm' }}</span><br>
                    {% if gift_card and gift_card.balance %}Saldo: {{ gift_card.balance | money_with_currency }}<br>{% endif %}
                    <a href="{{ store_url }}" target="_blank" style="color:#ff4d4d; text-decoration:none;">Visitar la tienda &rsaquo;</a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- 7. Franja inferior delgada -->
          <tr>
            <td style="background-color:#780606; height:8px; font-size:1px; line-height:1px;">&nbsp;</td>
          </tr>
        </table>

        <!--[if gte mso 9]>
        </v:textbox>
        </v:rect>
        <![endif]-->

      </td>
    </tr>
  </table>

  <!-- Copiado del código (solo en navegador; los clientes de correo ignoran scripts) -->
  <script type="text/javascript">
    function ctCopyCode() {
      var code = (document.getElementById('ctCode') || {}).textContent || '{{ discount_code }}';
      code = code.trim();
      var msg = document.getElementById('ctCopyMsg');
      function done() {
        if (!msg) return;
        msg.textContent = ' ¡Código copiado!';
        setTimeout(function () { msg.textContent = ''; }, 2200);
      }
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(code).then(done, fallback);
      } else {
        fallback();
      }
      function fallback() {
        var t = document.createElement('textarea');
        t.value = code;
        t.style.position = 'fixed';
        t.style.left = '-9999px';
        document.body.appendChild(t);
        t.select();
        try { document.execCommand('copy'); done(); } catch (e) {}
        document.body.removeChild(t);
      }
    }
  </script>

</body>
</html>
